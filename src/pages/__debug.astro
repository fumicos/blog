---
// src/pages/__debug.astro
import { getPosts } from '../lib/microcms';

const { contents = [] } = await getPosts(100, 0);
const items = contents.map(p => ({ slug: (p.slug ?? p.id).toLowerCase(), title: p.title ?? (p.slug ?? p.id) }));
---
<html lang="ja">
  <head><meta charset="utf-8" /><title>Debug Index</title></head>
  <body class="prose mx-auto p-6">
    <h1>Generated Slugs</h1>
    <ul>
      {items.map(i => <li><a href={`/${i.slug}`}>{i.title} — /{i.slug}</a></li>)}
    </ul>
  </body>
</html>
