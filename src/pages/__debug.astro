---
import { getPosts } from '../lib/microcms';

let contents = [];
try {
  const res = await getPosts(100, 0); // build時に実行
  contents = res?.contents ?? [];
} catch (e) {
  console.error('[__debug] fetch failed', e);
  contents = [];
}
---
<html lang="ja">
  <body class="prose mx-auto p-6">
    <h1>Generated Slugs</h1>
    <ul>
      {contents.map((p) => {
        const slug = String(p.slug ?? p.id).toLowerCase();
        return <li><a href={`/${slug}`}>{p.title ?? slug} — /{slug}</a></li>;
      })}
    </ul>
  </body>
</html>
